# Unity writes its text assets with LF line endings. Check them out the same way, so that Unity re-saving a
# material or a settings file doesn't show it as changed on Windows (where Git would otherwise use CRLF).
*.mat        text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.asmdef     text eol=lf
